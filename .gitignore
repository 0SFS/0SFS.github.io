node_modules/
dist/
GOOGLE_3D_TILES.local.md
.DS_Store

# Editor workspaces, such as the local flight-development.code-workspace.
*.code-workspace

# Local build/validation artifacts; identities and outcomes are documented.
# Generated benchmark fixtures belong here (e.g. build/benchmarks/audio/).
/build/

# Python bytecode, written whenever Blender or a script imports a module.
__pycache__/
*.pyc

# Third-party images whose reuse rights are unknown: TurboSquid previews, a
# user-supplied reference and YouTube stills. They stay on the machine that
# collected them; the records beside them keep each source URL and SHA-256.
/validation/evidence/aircraft/f35b/engine-rebuild-2026-10-06/turbosquid/*.jpg
/validation/evidence/aircraft/f35b/engine-rebuild-2026-10-06/user-reference/*.webp
/validation/evidence/aircraft/f35b/engine-review-2026-10-06/frames/
/validation/evidence/aircraft/f35b/night-climb-comparison-2026-10-06/*.png
/validation/evidence/aircraft/f35b/dry-vtol-mechanism-2026-10-06/footage/*.png

# Per-step physics traces, 235 MB, too large for every clone to carry. They stay
# on the machine that recorded them; index.json and each case's manifest keep
# their hashes.
/validation/evidence/aircraft/f35b/powered-lift-stability-2026-10-08/physics/*/*.f64-delta.br

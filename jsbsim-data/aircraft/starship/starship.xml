  <flight_control name="FCS">
    <channel name="Pitch">
      <summer name="fcs/elevator-pos-rad">
        <input>fcs/elevator-cmd-norm</input>
        <clipto><min>-1</min><max>1</max></clipto>
      </summer>
    </channel>
    <channel name="Roll">
      <summer name="fcs/aileron-pos-rad">
        <input>fcs/aileron-cmd-norm</input>
        <clipto><min>-1</min><max>1</max></clipto>
      </summer>
    </channel>
    <channel name="Yaw">
      <summer name="fcs/rudder-pos-rad">
        <input>fcs/rudder-cmd-norm</input>
        <clipto><min>-1</min><max>1</max></clipto>
      </summer>
    </channel>
    <channel name="Throttle">
      <pure_gain name="fcs/throttle-cmd-norm[1]">
        <input>fcs/throttle-cmd-norm</input>
        <gain>1</gain>
      </pure_gain>
      <switch name="propulsion/set-running">
        <default value="0"/>
        <test value="-1">
          fcs/throttle-cmd-norm GE 0.4
        </test>
      </switch>
    </channel>
  </flight_control>

  <aerodynamics>
    <axis name="DRAG">
      <function name="aero/coefficient/CD">
        <description>Nose-on drag near 0.4, broadside drag near 8, on the body cross-section.</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <table>
            <independentVar lookup="row">aero/alpha-rad</independentVar>
            <tableData>
              -3.1416  6
              -1.5708  8
               0       0.4
               1.5708  8
               3.1416  6
            </tableData>
          </table>
        </product>
      </function>
    </axis>
    <axis name="SIDE">
      <function name="aero/coefficient/CY">
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>aero/beta-rad</property>
          <value>-4</value>
        </product>
      </function>
    </axis>
    <axis name="LIFT">
      <function name="aero/coefficient/CL">
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <value>0</value>
        </product>
      </function>
    </axis>
    <axis name="ROLL">
      <function name="aero/moment/Roll">
        <sum>
          <product>
            <property>fcs/aileron-cmd-norm</property>
            <value>1355515.1</value>
          </product>
          <product>
            <property>fcs/roll-trim-cmd-norm</property>
            <value>406654.5</value>
          </product>
          <product>
            <property>velocities/p-rad_sec</property>
            <value>-3883264.7</value>
          </product>
        </sum>
      </function>
    </axis>
    <axis name="PITCH">
      <function name="aero/moment/Pitch">
        <sum>
          <product>
            <property>fcs/elevator-cmd-norm</property>
            <value>-11427605.9</value>
          </product>
          <product>
            <property>fcs/pitch-trim-cmd-norm</property>
            <value>-3428281.8</value>
          </product>
          <product>
            <property>velocities/q-rad_sec</property>
            <value>-54562799</value>
          </product>
          <product>
            <property>aero/qbar-psf</property>
            <property>metrics/Sw-sqft</property>
            <property>metrics/cbarw-ft</property>
            <property>aero/alpha-rad</property>

+    def assert_run_ic_preserves_off_spools(self, fdm, throttles):
+        for throttle in throttles:
+            with self.subTest(throttle=throttle):
+                fdm["fcs/throttle-cmd-norm[0]"] = throttle
+                before_time = fdm.get_sim_time()

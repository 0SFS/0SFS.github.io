+            self.assertEqual(fdm[ENGINE + "fuel-flow-rate-pps"], 0.0)
+        self.assertGreater(fdm.get_sim_time(), before_time)
+        self.assertEqual(fdm[ENGINE + "fuel-used-lbs"], fuel_used)

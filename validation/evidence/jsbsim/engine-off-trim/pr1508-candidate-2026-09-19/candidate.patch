From 8945b0e34ddc85df1d324dffbe39d0732b03197d Mon Sep 17 00:00:00 2001
From: Felipegalind0 <Felipegalind0@outlook.com>
Date: Sat, 19 Sep 2026 17:35:40 -0500
Subject: [PATCH 2/2] Leave an engine that is off out of the trim fuel state

FGTurbine::Calculate() selects tpTrim whenever in.TotalDeltaT is zero,
independently of any aircraft trim request, so zero-time evaluations such as
RunIC() reach Trim() even when the engine is off. The steady fuel assignments
added for the trim case ran for every engine, so an engine that had never been
started, or that had been cut off and spooled down, came out of RunIC()
reporting the throttle's running fuel flow and corrected TSFC. Off() then seeks
that flow back to zero over the following frames, and CalcFuelNeed() debits the
tanks for it: on the F16 fixture a never-started engine burned 0.35 lb dry and
2.6 lb with augmentation requested, in 0.2 s.

Commit the running state - N1, N2 and N2norm - and evaluate the TSFC and fuel
targets only when the engine is running. The steady speed and its
normalization are still computed unconditionally as locals, and the thrust and
the AugMethod 1 threshold still use them, so what Trim() returns is unchanged
in every case: twelve never-started, cut-off and running cases at a dry and an
augmented throttle, with augmethod 1 and 2, are identical to this PR's previous
implementation. An engine that is off keeps its own, possibly windmilling,
spools and its own fuel state.

A running engine is unaffected. N2norm is still updated before TSFC is
evaluated, so a configured TSFC parameter still sees the operating point being
trimmed; measured with an XML tsfc function reading the engine's N2, all six
running cases match the previous implementation exactly.

TestTurbineTrimFuelFlow keeps its three running checks and adds the two
off-engine cases - never started and started then cut off - requiring the
engine to be off before the call and its flow, corrected TSFC, spools,
simulation time, tank contents and fuel used to come back unchanged, then
requiring the following frames to burn nothing. This does not claim that every
turbine's fuel flow is zero once it is shut down; the fixture's has settled
there before the comparison is taken.
---
 src/models/propulsion/FGTurbine.cpp |  27 ++++---
 tests/TestTurbineTrimFuelFlow.py    | 120 +++++++++++++++++++++++++++-
 2 files changed, 135 insertions(+), 12 deletions(-)

diff --git a/src/models/propulsion/FGTurbine.cpp b/src/models/propulsion/FGTurbine.cpp
index b928f770..416834a6 100644
--- a/src/models/propulsion/FGTurbine.cpp
+++ b/src/models/propulsion/FGTurbine.cpp
@@ -353,23 +353,30 @@ double FGTurbine::Trim()
     double idlethrust = MilThrust * IdleThrustLookup->GetValue();
     double milthrust = (MilThrust - idlethrust) * MilThrustLookup->GetValue();
     double steadyN2 = IdleN2 + ThrottlePos * N2_factor;
+    double steadyN2norm = (steadyN2 - IdleN2) / N2_factor;
     // Trim establishes steady thrust without advancing time. Keep a running
-    // engine's observable spool state consistent with that operating point.
-    // Zero-time evaluations, such as RunIC(), can reach Trim even when the
-    // engine is off. Such an engine keeps its (possibly windmilling) spools.
+    // engine's observable spool state and fuel flow consistent with that
+    // operating point. Zero-time evaluations, such as RunIC(), can reach Trim
+    // even when the engine is off. Such an engine keeps its (possibly
+    // windmilling) spools and its existing fuel state: the throttle describes
+    // no operating point it is in, and a steady flow assigned here would be
+    // reported and then burned as it decayed.
     if (Running) {
       N1 = IdleN1 + ThrottlePos * N1_factor;
       N2 = steadyN2;
+      N2norm = steadyN2norm;
     }
-    N2norm = (steadyN2 - IdleN2) / N2_factor;
-    double dryThrust = idlethrust + (milthrust * N2norm * N2norm);
+    double dryThrust = idlethrust + (milthrust * steadyN2norm * steadyN2norm);
     double thrust = dryThrust * (1.0 - BleedDemand);
 
     // Run() derives fuel flow from the thrust produced before bleed extraction
     // is deducted. Trim has no time to seek that value, so assign the same
-    // steady product directly; TSFC is evaluated at this operating point.
-    correctedTSFC = TSFC->GetValue();
-    FuelFlow_pph = std::max(IdleFF, dryThrust * correctedTSFC);
+    // steady product directly; TSFC is evaluated at this operating point,
+    // after N2norm has been updated to it.
+    if (Running) {
+      correctedTSFC = TSFC->GetValue();
+      FuelFlow_pph = std::max(IdleFF, dryThrust * correctedTSFC);
+    }
 
     if (AugMethod == 1) {
       if ((ThrottlePos > 0.99) && (steadyN2 > 97.0)) {Augmentation = true;}
@@ -378,14 +385,14 @@ double FGTurbine::Trim()
 
     if ((Augmented == 1) && Augmentation && (AugMethod < 2)) {
       thrust = MaxThrust * MaxThrustLookup->GetValue();
-      FuelFlow_pph = thrust * ATSFC->GetValue();
+      if (Running) FuelFlow_pph = thrust * ATSFC->GetValue();
     }
 
     if (AugMethod == 2) {
       if (AugmentCmd > 0.0) {
         double tdiff = (MaxThrust * MaxThrustLookup->GetValue()) - thrust;
         thrust += (tdiff * std::min(AugmentCmd, 1.0));
-        FuelFlow_pph = thrust * ATSFC->GetValue();
+        if (Running) FuelFlow_pph = thrust * ATSFC->GetValue();
       }
     }
 

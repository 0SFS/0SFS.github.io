+            self.assertEqual(fdm[ENGINE + "set-running"], 0)
+            flow = fdm[FUEL_FLOW]
+            self.assertLessEqual(flow, previous)
+            previous = flow
+            if flow == 0.0:
+                break
+        self.assertEqual(previous, 0.0)

<?xml version="1.0"?>
<!-- 0SFS modifications 2026-10-05: experimental single-engine STOVL accounting;
     original GPL source retained in planes/Lockheed_Martin_F-35B/tests/flightgear-jsbsim. -->

<!--
  File:     sidefan.xml
  Author:   Aero-Matic v 0.81

  Inputs:
    name:           sidefan
    type:           turbine
    thrust:         1950 lb
    augmented?      no
    injected?       no
-->

<turbine_engine name="enginerotated">
  <milthrust> 1950.0 </milthrust>
  <bypassratio>     1.0 </bypassratio>
  <tsfc>0</tsfc>
  <idlefuelflow>0</idlefuelflow>
  <bleed>0</bleed>
  <idlen1>         30.0 </idlen1>
  <idlen2>         60.0 </idlen2>
  <maxn1>         100.0 </maxn1>
  <maxn2>         100.0 </maxn2>
  <augmented>         0 </augmented>
  <injected>          0 </injected>

  <function name="IdleThrust"><value>0</value></function>

  <!-- Existing atmospheric capacity caps the force allocated from the
       actual main nozzle upward body vector, evaluated earlier this step. -->
  <function name="MilThrust">
    <min>
      <table>
    <independentVar lookup="row">velocities/mach</independentVar>
    <independentVar lookup="column">atmosphere/density-altitude</independentVar>
    <tableData>
          -10000       0   10000   20000   30000   40000   50000 	80000
     0.0   1.2600  1.0000  0.7400  0.5340  0.3720  0.2410  0.1490 	0
     0.2   1.1710  0.9340  0.6970  0.5060  0.3550  0.2310  0.1430 	0
     0.4   1.1500  0.9210  0.6920  0.5060  0.3570  0.2330  0.1450 	0
     0.6   1.1810  0.9510  0.7210  0.5320  0.3780  0.2480  0.1540 	0
     0.8   1.2580  1.0200  0.7820  0.5820  0.4170  0.2750  0.1700 	0
     1.0   1.3690  1.1200  0.8710  0.6510  0.4750  0.3150  0.1950 	0
     1.2   1.4850  1.2300  0.9750  0.7440  0.5450  0.3640  0.2250 	0
     1.4   1.5941  1.3400  1.0860  0.8450  0.6280  0.4240  0.2630 	0
     1.6 	0 	0 	0 	0 	0 	0	0 	0
    </tableData>
   </table>
      <quotient>
        <product>
          <max><value>0</value><property>-propulsion/engine[0]/body-force-z-lbs</property></max>
          <value>0.10833333333333333</value>
          <property>propulsion/engine[#]/roll-post-allocation</property>
        </product>
        <value>1950</value>
      </quotient>
    </min>
  </function>


  <!-- Force carriers track allocation immediately; actual main-engine force
       supplies power. These are not independent fan/roll-post turbine spools. -->
  <function name="N1SpoolUp"><quotient><value>100</value>
    <max><value>0.000001</value><property>simulation/dt</property></max>
  </quotient></function>
  <function name="N1SpoolDown"><quotient><value>100</value>
    <max><value>0.000001</value><property>simulation/dt</property></max>
  </quotient></function>
  <function name="N2SpoolUp"><quotient><value>100</value>
    <max><value>0.000001</value><property>simulation/dt</property></max>
  </quotient></function>
  <function name="N2SpoolDown"><quotient><value>100</value>
    <max><value>0.000001</value><property>simulation/dt</property></max>
  </quotient></function>

</turbine_engine>

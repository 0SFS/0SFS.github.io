{
  "name": "flight-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./layers": "./src/compat/layers.ts",
    "./cameraMath": "./src/compat/cameraMath.ts",
    "./smoothElevation": "./src/compat/smoothElevation.ts",
    "./style.css": "./src/styles/globe.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "ci": "npm run lint && npm run test && npm run build",
    "deploy": "npm run deploy:gh-pages",
    "deploy:gh-pages": "npm run build -- --base=/flight-sim/ && gh-pages -d dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@0x62/jsbsim-wasm": "^1.2.4-beta.4",
    "@babylonjs/core": "^8.21.1",
    "@babylonjs/loaders": "^8.21.1",
    "3d-tiles-renderer": "^0.4.24",
    "foss-earth": "file:../foss-earth",
    "lucide-react": "^1.41.0",
    "peerjs": "1.5.5",
    "qrcode": "1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.0.8"
  }
}

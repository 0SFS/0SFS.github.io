{
  "name": "osfs",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./layers": "./src/compat/layers.ts",
    "./cameraMath": "./src/compat/cameraMath.ts",
    "./smoothElevation": "./src/compat/smoothElevation.ts",
    "./style.css": "./src/styles/globe.css"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "node scripts/dev-lan.mjs",
    "build": "npm run verify:jsbsim && npm run verify:audio && tsc -b && vite build && node scripts/verify-jsbsim-artifact.mjs --dist=dist && node scripts/verify-audio-artifact.mjs --dist=dist",
    "build:audio": "node scripts/build-audio-wasm.mjs",
    "check:phone-layout": "node scripts/check-phone-layout.mjs",
    "ci": "npm run lint && npm run test && npm run build",
    "deploy": "npm run deploy:gh-pages",
    "deploy:gh-pages": "npm run build && gh-pages -d dist",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:changed": "vitest run --passWithNoTests --changed",
    "test:watch": "vitest",
    "verify:jsbsim": "node scripts/verify-jsbsim-artifact.mjs",
    "verify:audio": "node scripts/verify-audio-artifact.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^8.21.1",
    "@babylonjs/loaders": "^8.21.1",
    "@felipegalind0/gamepad-tools": "file:../Felipegalind0/gamepad-tools",
    "@felipegalind0/jsbsim": "file:deps/felipegalind0-jsbsim-1.2.4-fork.7.tgz",
    "3d-tiles-renderer": "^0.4.24",
    "foss-earth": "file:../foss-earth",
    "jsqr": "1.4.0",
    "lucide-react": "^1.41.0",
    "peerjs": "1.5.5",
    "qrcode": "1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@webgpu/types": "^0.1.74",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=22.18"
  }
}
